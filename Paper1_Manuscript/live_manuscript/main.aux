\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Fibrosis-stage expression patterns and stability.} (a) Individual gene profiles (grey) and cluster centroids (red), standardised across F0--F4. (b) Heatmap of the same profiles. (c) Silhouette and stability diagnostics; error bars show SD across 50 refits. Patterns describe cross-sectional stage differences, not longitudinal trajectories. Grey lines represent genes, not confidence intervals.\relax }}{15}{figure.caption.25}\protected@file@percent }
\newlabel{fig:3}{{3}{15}{\textbf {Fibrosis-stage expression patterns and stability.} (a) Individual gene profiles (grey) and cluster centroids (red), standardised across F0--F4. (b) Heatmap of the same profiles. (c) Silhouette and stability diagnostics; error bars show SD across 50 refits. Patterns describe cross-sectional stage differences, not longitudinal trajectories. Grey lines represent genes, not confidence intervals.\relax }{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Five cross-sectional fibrosis expression patterns (continued).} (b) Heatmap of the row-standardised gene profiles, with cluster sizes and the stage-profile colour scale.\relax }}{16}{figure.caption.26}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Five cross-sectional fibrosis expression patterns (continued).} (c) Cluster-number diagnostics. Error bars show standard deviations across 50 refits; the highlighted choice is k = 5.\relax }}{17}{figure.caption.27}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Adjacent-stage contrasts and functional enrichment.} (a) Substantial-gene counts, median counts from 50 matched refits and median absolute study-adjusted coefficients. Substantial differences require BH \(q<0.05\) and \(|\beta |\geq 0.2\) within-study SD units. Matched refits use 30 patients per stage with fixed study composition; bars show medians without error bars. (b) Hallmark enrichment across direction groups and clusters against 14,794 genes. Colour denotes \(-\qopname  \relax o{log}_{10}(q)\), capped at 10; lightest cells indicate no significant enrichment.\relax }}{18}{figure.caption.29}\protected@file@percent }
\newlabel{fig:4}{{4}{18}{\textbf {Adjacent-stage contrasts and functional enrichment.} (a) Substantial-gene counts, median counts from 50 matched refits and median absolute study-adjusted coefficients. Substantial differences require BH \(q<0.05\) and \(|\beta |\geq 0.2\) within-study SD units. Matched refits use 30 patients per stage with fixed study composition; bars show medians without error bars. (b) Hallmark enrichment across direction groups and clusters against 14,794 genes. Colour denotes \(-\log _{10}(q)\), capped at 10; lightest cells indicate no significant enrichment.\relax }{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Adjacent-stage comparisons and functional enrichment (continued).} (b) Hallmark enrichment heatmap. Colour represents enrichment significance, with \(-\qopname  \relax o{log}_{10}(q)\) capped at 10.\relax }}{19}{figure.caption.30}\protected@file@percent }
