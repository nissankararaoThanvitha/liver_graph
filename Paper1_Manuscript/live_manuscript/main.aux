\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Fibrosis and disease-group associations.} (a) Overlap of selected gene sets. (b) Median study correlations for the 1,822 shared genes. The displayed Spearman statistic compares the two correlation vectors across genes. Selection required BH \(q<0.05\), consistent direction in all testable studies and at least three studies. Disease-group ordering denotes control/NAFL/NASH classifications, not a direct inflammation measurement.\relax }}{14}{figure.caption.23}\protected@file@percent }
\newlabel{fig:2}{{2}{14}{\textbf {Fibrosis and disease-group associations.} (a) Overlap of selected gene sets. (b) Median study correlations for the 1,822 shared genes. The displayed Spearman statistic compares the two correlation vectors across genes. Selection required BH \(q<0.05\), consistent direction in all testable studies and at least three studies. Disease-group ordering denotes control/NAFL/NASH classifications, not a direct inflammation measurement.\relax }{figure.caption.23}{}}
