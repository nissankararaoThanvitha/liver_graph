47", "ENSG00000260001", "ENSG00000260916", "ENSG00000261115", "ENSG00000261221", "ENSG00000261701", "ENSG00000261739", "ENSG00000264424", "ENSG00000266173", "ENSG00000266964", "ENSG00000267534", "ENSG00000269113", "ENSG00000272636"];

MATCH (d:Drug)-[r:ACTS_ON]->(g:Gene)
WHERE g.ensembl_id IN $ids
RETURN count(r) AS links, count(DISTINCT g) AS genes, count(DISTINCT d) AS drugs;

// Same query returning the rows saved in Task2/drug_gene_edges.csv:
MATCH (d:Drug)-[r:ACTS_ON]->(g:Gene)
WHERE g.ensembl_id IN $ids
RETURN d.node_id AS drug_id, d.name AS drug, g.symbol AS gene, r.action AS action,
       r.evidence_level AS evidence_level, r.sources_direct AS sources,
       r.mechanisms_of_action AS mechanism, d.max_phase AS max_phase, d.is_approved AS approved
ORDER BY gene, drug
LIMIT 50;
