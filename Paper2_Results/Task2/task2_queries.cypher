// =====================================================================
// Paper 2 — Task 2 queries (drug–gene links), for Neo4j Browser
// Database: liver_kg / neo4j. All queries are READ-ONLY.
// Run one block at a time. "Expected" = the result we got.
// =====================================================================


// ---------- 1. Fibrosis genes and their drugs (no setup needed) ----------
// Every drug linked to a Paper 1 fibrosis gene (TRACKS_FIBROSIS = 3,845 genes).
// Expected: links 7,071 · genes 717 · drugs 2,580
MATCH (d:Drug)-[r:ACTS_ON]->(g:Gene)-[:TRACKS_FIBROSIS]->(:Disease)
RETURN count(r) AS links, count(DISTINCT g) AS genes, count(DISTINCT d) AS drugs;


// ---------- 2. How do the drugs act? (action labels) ----------
// Expected top rows: TARGET 2,918 · ENZYME 1,824 · TRANSPORTER 1,054 · CARRIER 450 ·
// INHIBITOR 375 · AGONIST 152 · ANTAGONIST 117
// TARGET/ENZYME/TRANSPORTER/CARRIER = direction unknown.
MATCH (d:Drug)-[r:ACTS_ON]->(g:Gene)-[:TRACKS_FIBROSIS]->(:Disease)
RETURN r.action AS action, count(*) AS links
ORDER BY links DESC;


// ---------- 3. Fibrosis genes with the most drugs (real drug targets only) ----------
// Expected: ADRA1A 115 (falls) · HTR2A 106 (falls) · ADRA2A 96 (rises) · ESR1 93 ·
// GABRB3 79 · GABRE 75 · AR 73 · PTGS2 72 · PTGS1 71 · ADRA2C 70
MATCH (d:Drug)-[r:ACTS_ON]->(g:Gene)-[t:TRACKS_FIBROSIS]->(:Disease)
WHERE NOT r.action IN ['ENZYME','TRANSPORTER','CARRIER']
RETURN g.symbol AS gene, t.direction AS with_fibrosis, round(t.rho*1000)/1000 AS rho,
       count(DISTINCT d) AS drugs
ORDER BY drugs DESC LIMIT 10;


// ---------- 4. One gene in detail: PDGFRA (Paper 1 shortlist gene) ----------
// Shows the evidence kept for every link: action, evidence level, sources, mechanism.
// Expected: regorafenib, ripretinib, pazopanib, nintedanib, sunitinib, midostaurin =
// INHIBITOR (multi-source: DrugBank + Open Targets); fostamatinib, erdafitinib = TARGET.
MATCH (d:Drug)-[r:ACTS_ON]->(g:Gene {symbol:'PDGFRA'})
RETURN d.name AS drug, d.max_phase AS phase, r.action AS action,
       r.evidence_level AS evidence, r.sources_direct AS sources,
       r.mechanisms_of_action AS mechanism
ORDER BY phase DESC, drug;


// ---------- 5. Picture for the Browser: PDGFRA and its inhibitors ----------
// Switch to the Graph view to see the network. Expected: 7 inhibitor drugs.
MATCH p = (d:Drug)-[r:ACTS_ON]->(g:Gene {symbol:'PDGFRA'})-[:TRACKS_FIBROSIS]->(x:Disease)
WHERE r.action = 'INHIBITOR'
RETURN p;


// ---------- 6. Evidence quality: single- vs multi-source ----------
// Expected (fibrosis genes): single-source 6,198 · multi-source 873
MATCH (d:Drug)-[r:ACTS_ON]->(g:Gene)-[:TRACKS_FIBROSIS]->(:Disease)
RETURN r.evidence_level AS evidence_level, count(*) AS links;


// =====================================================================
